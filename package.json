{
  "name": "maps-tour",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-location": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:infrastructure": "jest --runInBand --testPathPatterns=infrastructure",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run check-progress && npm test"
  },
  "private": true,
  "devDependencies": {
    "@babel/parser": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  }
}
